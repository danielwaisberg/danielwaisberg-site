    "jobTitle": "Search Advocate",
    "worksFor": { "@type": "Organization", "name": "Google" },
    "url": "https://danielwaisberg.com/",
    "email": "contact.danielwaisberg@gmail.com",
    "knowsLanguage": ["Portuguese", "Hebrew", "English", "Spanish"],
    "sameAs": [
      "https://www.linkedin.com/in/danielwaisberg/",
      "https://developers.google.com/search/blog/authors/daniel-waisberg"
    ]
